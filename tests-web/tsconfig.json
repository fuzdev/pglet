{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"allowJs": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["node"]
	},
	"include": [
		"vitest.config.ts",
		"lib/assert.ts",
		"lib/server.ts",
		"drivers/**/*_test.ts",
		"orms/**/*_test.ts",
		"integration/pglet_test.ts",
		"integration/server_test.ts",
		"integration/pglet_wasm_test.ts",
		"integration/depth_edge.ts",
		"integration/module_poison.ts",
		"integration/host_exceptions.ts",
		"browser/run.ts"
	]
}
